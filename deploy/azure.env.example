# The VM's public name from Azure, e.g. badal-tracker.centralindia.cloudapp.azure.com  (no https://, no slash).
# It is written into every email you send: never change it once you are using the tracker.
TRACK_HOST=your-name.region.cloudapp.azure.com

# Generate each secret with:  openssl rand -hex 32
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
TRACKER_API_KEY=
# Comma-separated. The FIRST signs new links; all verify. To rotate: put a new secret first and keep the old one.
TRACKER_SIGNING_SECRETS=
