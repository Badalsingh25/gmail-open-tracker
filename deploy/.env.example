# Two DNS A records pointing at this server, e.g. track.example.com and api.example.com.
# TRACK_DOMAIN is baked into every email you send: keep it stable for good.
TRACK_DOMAIN=track.example.com
API_DOMAIN=api.example.com

# Generate each secret with:  openssl rand -hex 32
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
TRACKER_API_KEY=
# Comma-separated. The FIRST signs new links; all verify. To rotate: put a new secret first and keep the old one.
TRACKER_SIGNING_SECRETS=
